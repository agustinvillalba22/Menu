DATABASE_URL=postgresql+asyncpg://menu:menu@localhost:5432/menu_dev
SECRET_KEY=changeme-use-a-long-random-string
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
APP_NAME=Menu
# Logging level (DEBUG, INFO, WARNING, ERROR). Default INFO.
LOG_LEVEL=INFO
# Auth cookie SameSite: lax (default) | strict | none.
# `none` (cross-site frontend/API) requires COOKIE_SECURE=true or startup fails.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Cloudflare R2 — object storage for product/logo images (M4, not implemented yet).
# S3-compatible: same boto3 client as AWS S3, pointed at R2_ENDPOINT_URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=menu-test
# Public read URL for serving images (r2.dev subdomain or a custom domain
# attached to the bucket) — enable "Public Access" on the bucket first.
R2_PUBLIC_URL=

# Fase 0a — IANA timezone used as fallback when a restaurant has no explicit
# `timezone` set (and for flows with no restaurant context). Default UTC.
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Fase 2b (P2) — multi-menu auto-switching kill-switch. false = back-compat
# (every restaurant serves its default menu).
MENU_SCHEDULING_ENABLED=true

# M36 — Mercado Pago (Checkout Pro). Every variable is optional: if any is
# empty the payment option simply stays disabled and the app starts normally.
# Credentials come from your application in Mercado Pago Developers.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Secret used to validate webhook signatures (Webhooks section of the app).
MP_WEBHOOK_SECRET=
# Fernet key used to encrypt each restaurant's tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=
# Public base URL of this backend (no trailing slash). Mercado Pago calls it
# back at <PUBLIC_API_URL>/payments/mercadopago/callback (OAuth redirect URI)
# and <PUBLIC_API_URL>/webhooks/mercadopago. Must be reachable from the
# internet (use a tunnel in local development).
PUBLIC_API_URL=
# Base URL of the frontend (no trailing slash), e.g. http://localhost:3000.
FRONTEND_URL=
