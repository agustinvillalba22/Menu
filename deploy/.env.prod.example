# Variables de la VM de producción. Copiar a /opt/menu/.env, completar a mano y
# `chmod 600 /opt/menu/.env`. NUNCA commitear el .env real ni copiar el de desarrollo.
# Los valores con caracteres especiales (JSON, $) van entre comillas simples.
# Este archivo solo contiene placeholders.

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=menu
# Alfanumérica (o URL-encoded si se pega en DATABASE_URL). Generar: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_ALFANUMERICA
POSTGRES_DB=menu
# Debe coincidir con las tres anteriores. Host fijo: el servicio `db` de Compose.
DATABASE_URL=postgresql+asyncpg://menu:CAMBIAR_POR_PASSWORD_ALFANUMERICA@db:5432/menu

# ---------------------------------------------------------------- App
# Aleatorio de al menos 64 caracteres. Generar: openssl rand -hex 48
SECRET_KEY=CAMBIAR_POR_SECRETO_ALEATORIO_DE_64_O_MAS_CARACTERES
ENVIRONMENT=production
LOG_LEVEL=INFO
# JSON (pydantic-settings lo parsea como lista). Sin comodín.
CORS_ORIGINS='["https://app.gurmeapp.com"]'
# Combinación de producción: Lax + Secure (app. y api. son el mismo site). No usar `none`.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
MENU_SCHEDULING_ENABLED=true

# ---------------------------------------------------------------- Cloudflare R2 (imágenes)
R2_ACCOUNT_ID=CAMBIAR
R2_ACCESS_KEY_ID=CAMBIAR
R2_SECRET_ACCESS_KEY=CAMBIAR
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://CAMBIAR.r2.cloudflarestorage.com
R2_BUCKET_NAME=CAMBIAR
# URL pública de lectura del bucket (debe ser https)
R2_PUBLIC_URL=https://CAMBIAR
# JWT_EXPIRE_MINUTES es opcional (usa el default de la app si no se define).

# ---------------------------------------------------------------- Mercado Pago
# SOLO credenciales de PRUEBA. No hay credenciales productivas en este proyecto.
# MP_TEST_SELLER_ACCESS_TOKEN es solo de desarrollo y NO se define en la VM.
MP_CLIENT_ID=CAMBIAR_CREDENCIAL_DE_PRUEBA
MP_CLIENT_SECRET=CAMBIAR_CREDENCIAL_DE_PRUEBA
# Secreto de firma de webhooks (panel de la aplicación de MP)
MP_WEBHOOK_SECRET=CAMBIAR
# Clave Fernet. Generar:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=CAMBIAR_CLAVE_FERNET
PUBLIC_API_URL=https://api.gurmeapp.com
FRONTEND_URL=https://app.gurmeapp.com

# ---------------------------------------------------------------- Infra
# Mail para Let's Encrypt (avisos de vencimiento)
ACME_EMAIL=CAMBIAR@example.com
# Usuario u organización de GitHub dueño del repo, en minúsculas (imágenes ghcr.io/<owner>/menu-*)
GHCR_OWNER=CAMBIAR_OWNER_EN_MINUSCULAS

# ---------------------------------------------------------------- Backups (rclone -> OCI Object Storage)
# Destino rclone `remote:bucket`. Si el remoto se llama `ocibackup`, backup.sh lo
# configura solo con las tres variables OCI_S3_* de abajo (no hace falta rclone.conf).
BACKUP_RCLONE_REMOTE=ocibackup:menu-backups
# Customer Secret Key de un usuario IAM dedicado (permiso solo sobre el bucket)
OCI_S3_ACCESS_KEY_ID=CAMBIAR
OCI_S3_SECRET_ACCESS_KEY=CAMBIAR
# https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
OCI_S3_ENDPOINT=https://CAMBIAR.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
